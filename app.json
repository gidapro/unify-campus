{
  "expo": {
    "name": "Unify Campus",
    "slug": "unify-campus",
    "scheme": "unifycampus",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unifycampus.app"
    },
    "android": {
      "package": "com.unifycampus.app"
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": { "origin": false }
    }
  }
}
