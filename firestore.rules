rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function sameSchool(schoolId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    // --- Utilisateurs -------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    // --- Ecoles / campus (lecture seule cote client) -------------------
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if false; // reserve a l'administration (Cloud Functions / console)
    }

    // --- Salles, cours, evenements : lecture filtree par ecole ---------
    match /rooms/{roomId} {
      allow read: if sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    match /courses/{courseId} {
      allow read: if sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if sameSchool(resource.data.schoolId);
      allow write: if false;
    }

    // --- Groupes --------------------------------------------------------
    match /groups/{groupId} {
      allow read: if sameSchool(resource.data.schoolId);
      allow update: if isSignedIn() && request.auth.uid in resource.data.adminIds;
      allow create: if sameSchool(request.resource.data.schoolId);
    }

    // --- Publications -----------------------------------------------
    match /posts/{postId} {
      allow read: if sameSchool(resource.data.schoolId);
      allow create: if sameSchool(request.resource.data.schoolId) &&
        request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.authorId);
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isOwner(request.resource.data.authorId);
      allow update, delete: if isOwner(resource.data.authorId);
    }

    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow write: if isOwner(request.resource.data.userId);
    }

    // --- Messagerie -------------------------------------------------
    match /conversations/{conversationId} {
      allow read, update: if isConversationParticipant(conversationId);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
    }

    match /messages/{messageId} {
      allow read: if isConversationParticipant(resource.data.conversationId);
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.senderId &&
        isConversationParticipant(request.resource.data.conversationId);
    }

    // --- Notifications : chaque utilisateur ne voit que les siennes ---
    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.userId);
      allow create: if false; // ecrites uniquement par des Cloud Functions
    }
  }
}
